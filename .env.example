# Copy this file to .env.local and fill in real values for local development.
# .env.local (and any .env*.local file) is gitignored — never commit real secrets.

# Yoco payment gateway secret key (test or live) — get this from your Yoco dashboard
YOCO_SECRET_KEY=

# Vercel Blob read/write token (used for storing order receipts) — get this from Vercel
BLOB_READ_WRITE_TOKEN=

# Canonical production site URL — used for metadata, sitemap.xml, robots.txt,
# and JSON-LD @id/url fields. Falls back to http://localhost:3000 in dev if unset.
NEXT_PUBLIC_SITE_URL=https://savage.umculo.app
